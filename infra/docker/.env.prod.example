POSTGRES_USER=skysync
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=skysync

JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes

HTTP_PORT=80
CORS_ORIGINS=http://localhost
FRONTEND_URL=https://skysync.example.com
LOG_FORMAT=json

# Optional email configuration. Leave empty to disable SMTP sending.
SMTP_HOST=
SMTP_USERNAME=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL="Skysync <noreply@skysync.example.com>"

MAX_FILE_SIZE_BYTES=1073741824
MAX_CONCURRENT_FILE_TRANSFERS=4
FILE_TRANSFER_TIMEOUT_SECONDS=900
TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_HOURS=24
